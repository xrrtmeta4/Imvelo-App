{
  "name": "imvelo-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "db:generate": "prisma migrate dev --name init && prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:studio": "prisma studio",
    "test": "tsx --test src/payment/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "zod": "^3.25.76",
    "helmet": "^8.1.0",
    "express-rate-limit": "^7.4.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2",
    "tsc-alias": "^1.8.11",
    "prisma": "^6.8.2"
  }
}
