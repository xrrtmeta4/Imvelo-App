# Server Configuration
DATABASE_URL="postgres://user:password@localhost:5432/imvelo_payments"
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173,http://localhost:4173"

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Vercel Analytics (optional)
VERCEL_ANALYTICS_ID=

# Backend API URL (defaults to proxy in dev, override for production)
VITE_API_URL=/api

# Dodo Payments Gateway Configuration
DODO_PAYMENTS_API_KEY=your_dodo_live_api_key_here
DODO_PRODUCT_ID="pdt_0NYZaqcOARihEXXOPIdmC"
DODO_PAYMENTS_ENV="live"
DODO_PAYMENT_METHODS="credit,debit,apple_pay,google_pay"
